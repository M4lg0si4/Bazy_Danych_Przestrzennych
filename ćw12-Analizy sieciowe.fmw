INCLUDE [ if {{BY_TWO_ATTRIBUTES} == {BY_ONE_ATTRIBUTE}} {    puts {MACRO FROM_TO_WEIGHT_ATTR_CLAUSE FROM_TO_WEIGHT_ATTR "@EvaluateExpression(FDIV,FLOAT,<at>Value<openparen>ForwardCost<closeparen>,ShortestPathFinder_2)"};    puts {MACRO TO_FROM_WEIGHT_ATTR_CLAUSE};    puts {MACRO COMPUTE_SHORTEST_PATH_CLAUSE COMPUTE_SHORTEST_PATH DIRECTED}; } elseif {{BY_TWO_ATTRIBUTES} == {BY_TWO_ATTRIBUTES}} {    puts {MACRO FROM_TO_WEIGHT_ATTR_CLAUSE FROM_TO_WEIGHT_ATTR "@EvaluateExpression(FDIV,FLOAT,<at>Value<openparen>ForwardCost<closeparen>,ShortestPathFinder_2)"};    puts {MACRO TO_FROM_WEIGHT_ATTR_CLAUSE TO_FROM_WEIGHT_ATTR "@EvaluateExpression(FDIV,FLOAT,<at>Value<openparen>ReverseCost<closeparen>,ShortestPathFinder_2)"};    puts {MACRO COMPUTE_SHORTEST_PATH_CLAUSE COMPUTE_SHORTEST_PATH UNDIRECTED}; } elseif {{BY_TWO_ATTRIBUTES} == {BY_LENGTH_FORWARD}} {    puts {MACRO COMPUTE_SHORTEST_PATH_CLAUSE COMPUTE_SHORTEST_PATH DIRECTED};    puts {MACRO FROM_TO_WEIGHT_ATTR_CLAUSE};    puts {MACRO TO_FROM_WEIGHT_ATTR_CLAUSE}; } elseif {{BY_TWO_ATTRIBUTES} == {BY_LENGTH}} {    puts {MACRO COMPUTE_SHORTEST_PATH_CLAUSE COMPUTE_SHORTEST_PATH UNDIRECTED};    puts {MACRO FROM_TO_WEIGHT_ATTR_CLAUSE};    puts {MACRO TO_FROM_WEIGHT_ATTR_CLAUSE}; } elseif {{BY_TWO_ATTRIBUTES} == {BY_STRAIGHT_LINE_DISTANCE}} {    puts {MACRO COMPUTE_SHORTEST_PATH_CLAUSE COMPUTE_SHORTEST_PATH STRAIGHT_LINE};    puts {MACRO FROM_TO_WEIGHT_ATTR_CLAUSE};    puts {MACRO TO_FROM_WEIGHT_ATTR_CLAUSE}; } ]
