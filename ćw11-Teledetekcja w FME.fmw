FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(SentinelDownloader_WORKSPACE_NAME)_TestFilter_4_INPUT }    INPUT  FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_AttributeRemover_5_OUTPUT"    OUTPUT { FEATURE_TYPE $(SentinelDownloader_WORKSPACE_NAME)_TestFilter_4_INPUTLINE }
