FACTORY_DEF {*} StringReplacerFactory    FACTORY_NAME { $(SentinelDownloader_WORKSPACE_NAME)_StringReplacer }    INPUT  FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_ALL<space>option"    INPUT  FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_3_All"    INPUT  FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_Bands<space>2<space>download"    INPUT  FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_3_Bands<space>2<space>download"    USE_REGEX { YES }    CASE_SENSITIVE { NO }    SOURCE_ATTRIBUTES { Nodes.uri }    FIND_TEXT { "<solidus>Nodes<dollar>" }    REPLACE_TEXT { "<solidus><dollar>value" }    REPLACE_NO_MATCH { "_FME_NO_OP_" }    OUTPUT { OUTPUT FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_StringReplacer_OUTPUT"          }
# -------------------------------------------------------------------------
FACTORY_DEF {*} AttributeKeeperFactory    FACTORY_NAME { $(SentinelDownloader_WORKSPACE_NAME)_AttributeKeeper_5 }    INPUT  FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_StringReplacer_OUTPUT"    KEEP_ATTRS { Id,Nodes.uri,access_token }    KEEP_LISTS {  }    KEEP_FME_ATTRIBUTES Yes    BUILD_FEATURE_TABLES { NO }    OUTPUT_ON_ATTRIBUTE_CHANGE { <Unused> }    OUTPUT { OUTPUT FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_AttributeKeeper_5_OUTPUT"        }
# -------------------------------------------------------------------------
# Combine the two "file path attribute" parameters into one value.
DEFAULT_MACRO $(SentinelDownloader_WORKSPACE_NAME)_HTTPCaller_10_FILE_PATH_ATTR
INCLUDE [ 	if { {_response_file_path} == {<Unused>} } { 		puts {MACRO $(SentinelDownloader_WORKSPACE_NAME)_HTTPCaller_10_FILE_PATH_ATTR "<Unused>"}; 	} else { 		puts {MACRO $(SentinelDownloader_WORKSPACE_NAME)_HTTPCaller_10_FILE_PATH_ATTR "_response_file_path"}; 	} ]
FACTORY_DEF {*} HTTPFactory    FACTORY_NAME { $(SentinelDownloader_WORKSPACE_NAME)_HTTPCaller_10 }       INPUT  FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_AttributeKeeper_5_OUTPUT"    TARGET_URL { "@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>Nodes.uri<closeparen>,$(SentinelDownloader_WORKSPACE_NAME)_HTTPCaller_10)" }    HTTP_METHOD { GET }    SAVE_FILE { YES }    OUTPUT_FILENAME { "@EvaluateExpression(FDIV,STRING,<at>Value<openparen>Id<closeparen>,$(SentinelDownloader_WORKSPACE_NAME)_HTTPCaller_10)" }    OUTPUT_DIRECTORY { "<Unused>" }    FILE_EXTENSION { "<Unused>" }    TARGET_ATTR { "<Unused>" }    FILE_PATH_ATTR { $($(SentinelDownloader_WORKSPACE_NAME)_HTTPCaller_10_FILE_PATH_ATTR) }    UPLOAD_FILE { "<Unused>" }    UPLOAD_BODY { "<Unused>" }    UPLOAD_TYPE { <Unused> }    UPLOAD_CONTENT_TYPE { "<Unused>" }    COMBINED_MULTIPART_TABLE {  }    MULTIPART_CONTENT_TYPE { <Unused> }    REQUEST_HEADER_TABLE { Authorization;@EvaluateExpression(FDIV,STRING_ENCODED,Bearer<space><at>Value<openparen>access_token<closeparen>,$(SentinelDownloader_WORKSPACE_NAME)_HTTPCaller_10) }    ADDITIONAL_URL_PARAMETERS {  }    AUTH_USERNAME { "<Unused>" }    AUTH_PASSWORD { "<Unused>" }    AUTH_METHOD { "<Unused>" }    TARGET_ATTRIBUTE_ENCODING { <Unused> }    RESPONSE_HEADER_LIST_ATTR { "" }    STATUS_CODE_ATTR { "_http_status_code" }    ERROR_ATTR { "_error" }    CONNECTION_TIMEOUT_LENGTH { 60 }    TRANSFER_TIMEOUT_LENGTH { 90 }    FOLLOW_REDIRECTS { FOLLOW_WITH_ORIGINAL_METHOD }    REDIRECT_AUTH { ORIGINAL_DOMAIN_ONLY }    VERIFY_SSL_CERTIFICATES { Yes }    NAMED_CONNECTION { "<Unused>" }    USE_COOKIES { No }    MAX_TRANSFERS_IN_PROGRESS { 2 }    MAX_HTTP_VERSION { HTTP_2 }    RATE_LIMIT_MAX_REQUESTS { <Unused> }    RATE_LIMIT_INTERVAL_IN_SECONDS { <Unused> }    RATE_LIMIT_REQUEST_TIMING { <Unused> }    RETRY_FAILED_TRANSFERS { <Unused> }    RETRY_MAX_RETRIES { <Unused> }    RETRY_INITIAL_BACKOFF { <Unused> }    SPLIT_MULTIPART_RESPONSE { <Unused> }    MULTIPART_RESPONSE_HEADER_LIST_ATTR { "<Unused>" }    MINIMUM_ENCRYPTION_LEVEL { "OS_DEFAULT" }    CLIENT_CERTIFICATE_TYPE { "NONE" }    CLIENT_CERTIFICATE_FROM_OS { "<Unused>" }    CLIENT_CERTIFICATE_FILE { "<Unused>" }    CLIENT_CERTIFICATE_PRIVATE_KEY_FILE { "<Unused>" }    CLIENT_CERTIFICATE_PASSWORD { "<Unused>" }    OUTPUT { OUTPUT FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_HTTPCaller_10_Output"          }    OUTPUT { REJECTED FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_HTTPCaller_10_<REJECTED>"          }
# -------------------------------------------------------------------------
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(SentinelDownloader_WORKSPACE_NAME)_Junction_2 }    INPUT  FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_Junction_4_Output"    INPUT  FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_HTTPCaller_8_<REJECTED>"    INPUT  FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_HTTPCaller_10_<REJECTED>"    OUTPUT { FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_Junction_2_Output"         }
# -------------------------------------------------------------------------
FACTORY_DEF {*} SortFactory    FACTORY_NAME { $(SentinelDownloader_WORKSPACE_NAME)_FeatureHolder }    INPUT  FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_Junction_2_Output"    FLUSH_WHEN_GROUPS_CHANGE { <Unused> }    OUTPUT { SORTED FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_FeatureHolder_OUTPUT"          }
# -------------------------------------------------------------------------
FACTORY_DEF {*} AttrSetFactory    COMMAND_PARM_EVALUATION SINGLE_PASS    FACTORY_NAME { $(SentinelDownloader_WORKSPACE_NAME)_AttributeManager }    INPUT  FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_FeatureHolder_OUTPUT"    MULTI_FEATURE_MODE { NO }    NULL_ATTR_MODE { NO_OP }    ATTRSET_CREATE_DIRECTIVES _PROPAGATE_MISSING_FDIV    ACTION_COLUMN 4    DEF_VAL_COLUMN 2    NUM_OF_COLUMNS 5    MISSING_INPUT_ATTR_HANDLING RENAME_SET_VALUE REMOVE    ATTR_ACTION { "Id" "Id" "" "buffer" "REMOVE" }      ATTR_ACTION { "_error" "_error" "" "buffer" "NO_OP" }      ATTR_ACTION { "fme_rejection_code" "fme_rejection_code" "" "buffer" "NO_OP" }      ATTR_ACTION { "_response_file_path" "_response_file_path" "" "buffer" "REMOVE" }      ATTR_ACTION { "_http_status_code" "_http_status_code" "" "buffer" "NO_OP" }      ATTR_ACTION { "nodes_url" "nodes_url" "" "varchar<openparen>200<closeparen>" "REMOVE" }      ATTR_ACTION { "_response_body" "_response_body" "" "buffer" "NO_OP" }      ATTR_ACTION { "image_identifier" "image_identifier" "" "buffer" "REMOVE" }      ATTR_ACTION { "json_type" "json_type" "" "buffer" "REMOVE" }      ATTR_ACTION { "json_index" "json_index" "" "uint32" "REMOVE" }      ATTR_ACTION { "access_token" "access_token" "" "buffer" "REMOVE" }      ATTR_ACTION { "ContentDate.Start" "ContentDate.Start" "" "buffer" "REMOVE" }      ATTR_ACTION { "Nodes.uri" "Nodes.uri" "" "buffer" "REMOVE" }      ATTR_ACTION { "base_url_S2" "base_url_S2" "" "buffer" "REMOVE" }      ATTR_ACTION { "productType" "productType" "" "varchar<openparen>200<closeparen>" "REMOVE" }      ATTR_ACTION { "cloud_cover" "cloud_cover" "" "varchar<openparen>200<closeparen>" "REMOVE" }      ATTR_ACTION { "daterange" "daterange" "" "varchar<openparen>200<closeparen>" "REMOVE" }      ATTR_ACTION { "location" "location" "" "varchar<openparen>200<closeparen>" "REMOVE" }      ATTR_ACTION { "url" "url" "" "varchar<openparen>200<closeparen>" "REMOVE" }      ATTR_ACTION { "lon" "lon" "" "real64" "REMOVE" }      ATTR_ACTION { "lat" "lat" "" "real64" "REMOVE" }      ATTR_ACTION { "_geometry" "_geometry" "" "buffer" "NO_OP" }    OUTPUT { OUTPUT FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_AttributeManager_OUTPUT"        }
# -------------------------------------------------------------------------
# The default behaviour is to abort on any feature entering the transformer.
# If Workbench has set the _WB_BYPASS_TERMINATION macro to a value of "Yes",
# then the features will instead be passed through with a feature type of
# __WB_BYPASS_TERMINATOR__, which Workbench will send to a visualizer or
# somesuch.
DEFAULT_MACRO _WB_BYPASS_TERMINATION No
FACTORY_DEF {*} TestFactory    FACTORY_NAME { $(SentinelDownloader_WORKSPACE_NAME)_Terminator_4 }    INPUT  FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_AttributeManager_OUTPUT"    TEST { "$(_WB_BYPASS_TERMINATION)" == Yes }    OUTPUT { PASSED FEATURE_TYPE __WB_BYPASS_TERMINATOR__       @SupplyAttributes(_wb_termination_feature_type,@FeatureType())       @SupplyAttributes(ENCODED,_wb_termination_message,"@EvaluateExpression(FDIV,STRING_ENCODED,Error<space>at<space>requesting<space>the<space>REST<space>API.<lf>HTTP<space>Code:<space><at>Value<openparen>_http_status_code<closeparen><lf>Error:<space><at>Value<openparen>_error<closeparen>,$(SentinelDownloader_WORKSPACE_NAME)_Terminator_4)")       @SupplyAttributes(_wb_termination_xformer,"$(SentinelDownloader_WORKSPACE_NAME)_Terminator_4")       @SupplyAttributes(_wb_termination_feature,Yes) }    OUTPUT { FAILED FEATURE_TYPE * @Abort(ENCODED,"@EvaluateExpression(FDIV,STRING_ENCODED,Error<space>at<space>requesting<space>the<space>REST<space>API.<lf>HTTP<space>Code:<space><at>Value<openparen>_http_status_code<closeparen><lf>Error:<space><at>Value<openparen>_error<closeparen>,$(SentinelDownloader_WORKSPACE_NAME)_Terminator_4)") }
# -------------------------------------------------------------------------
FACTORY_DEF {*} SortFactory    FACTORY_NAME { $(SentinelDownloader_WORKSPACE_NAME)_FeatureHolder_3 }    INPUT  FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_HTTPCaller_10_Output"    FLUSH_WHEN_GROUPS_CHANGE { <Unused> }    OUTPUT { SORTED FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_FeatureHolder_3_OUTPUT"          }
# -------------------------------------------------------------------------
MACRO $(SentinelDownloader_WORKSPACE_NAME)_FeatureReader_2_OUTPUT_PORTS_ENCODED JPEG2000
MACRO $(SentinelDownloader_WORKSPACE_NAME)_FeatureReader_2_DIRECTIVES COMPRESSION_CACHE_SIZE_CALCULATION,AUTO,EXPOSE_ATTRS_GROUP,FME_DISCLOSURE_OPEN,GROUP_BY_DATASET,No,JPEG2000_EXPOSE_FORMAT_ATTRS,fme_basename<comma>char<openparen>50<closeparen>,JPEG2000_RDR_ADV_PARM_GROUP,FME_DISCLOSURE_OPEN,PREFER_FILE_CS_UNITS,Yes,READ_OFFSETS_IN_CS_UNITS,No,READER_META_ATTRIBUTES,fme_dataset<space>fme_basename,USE_SEARCH_ENVELOPE,NO
# Always provide an INTERACTION, otherwise the factory defaults to ENVELOPE_INTERSECTS
INCLUDE [if { ( {NONE} == {<Unused>} ) || ( {($INTERACT)} == {} ) } {             puts {MACRO FCTQUERY_INTERACTION_LINE FCTQUERY_INTERACTION NONE};          } else {             puts {MACRO FCTQUERY_INTERACTION_LINE FCTQUERY_INTERACTION "NONE"};          }         ]
# Consolidate the attribute merge options to what the factory expects
DEFAULT_MACRO $(SentinelDownloader_WORKSPACE_NAME)_FeatureReader_2_COMBINE_ATTRS
INCLUDE [       if { {MERGE} == {MERGE} } {          puts "MACRO $(SentinelDownloader_WORKSPACE_NAME)_FeatureReader_2_COMBINE_ATTRS PREFER_RESULT";       } else {          puts "MACRO $(SentinelDownloader_WORKSPACE_NAME)_FeatureReader_2_COMBINE_ATTRS MERGE";       };    ]
INCLUDE [    puts {DEFAULT_MACRO FeatureReaderDataset_$(SentinelDownloader_WORKSPACE_NAME)_FeatureReader_2 @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>_response_file_path<closeparen>,$(SentinelDownloader_WORKSPACE_NAME)_FeatureReader_2)}; ]
FACTORY_DEF {*} QueryFactory    FACTORY_NAME { $(SentinelDownloader_WORKSPACE_NAME)_FeatureReader_2 }    INPUT  FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_FeatureHolder_3_OUTPUT"    $(FCTQUERY_INTERACTION_LINE)    CLIP_TO_INITIATOR_ENVELOPE { "NO" }    COMBINE_ATTRIBUTES  { $($(SentinelDownloader_WORKSPACE_NAME)_FeatureReader_2_COMBINE_ATTRS) }    IGNORE_NULLS        { No }    REJECT_POINTS       { YES }    QUERYFCT_ATTRIBUTE_PREFIX { <Unused> }    COMBINE_GEOMETRY    { RESULT_ONLY }    ENABLE_CACHE        { NO }    QUERYFCT_TABLE_SEPARATOR { SPACE }    READER_TYPE         { JPEG2000  }    READER_DATASET      { "$(FeatureReaderDataset_$(SentinelDownloader_WORKSPACE_NAME)_FeatureReader_2)" }    QUERYFCT_IDS        { "JPEG2000" }    QUERYFCT_IDS_FORMAT WWJD_PARTS    READER_DIRECTIVES   { METAFILE,JPEG2000 }    QUERYFCT_OUTPUT     { "BASED_ON_CONNECTIONS" }    QUERYFCT_ADD_SCHEMA { "NO" }    QUERYFCT_USE_SCHEMA_CACHE { "YES" }    QUERYFCT_INITIATOR_FIRST_OUTPUT { "default" }    QUERYFCT_DEDUPE_GEOM YES    CONTINUE_ON_READER_ERROR YES    ORDER_RESULTS { "No" }    QUERYFCT_RESULT_TAGS { $($(SentinelDownloader_WORKSPACE_NAME)_FeatureReader_2_OUTPUT_PORTS_ENCODED) }    QUERYFCT_SET_FME_FEATURE_TYPE YES    QUERYFCT_SET_FME_META_ATTRS YES    READER_PARAMS_WWJD     { $($(SentinelDownloader_WORKSPACE_NAME)_FeatureReader_2_DIRECTIVES) }    TREAT_READER_PARAM_AMPERSANDS_AS_LITERALS YES    HONOR_INITIATOR_COORDSYS YES    OUTPUT { READER_ERROR FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_FeatureReader_2_<REJECTED>"           }    OUTPUT JPEG2000 FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_FeatureReader_2_JPEG2000"
DEFAULT_MACRO _WB_BYPASS_TERMINATION No
FACTORY_DEF * TeeFactory FACTORY_NAME "$(SentinelDownloader_WORKSPACE_NAME)_FeatureReader_2_<Rejected>" INPUT FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_FeatureReader_2_<REJECTED>"  NO_LOGGING   OUTPUT FAILED FEATURE_TYPE * @Abort(ENCODED, SentinelDownloader_FeatureReader_2<space>output<space>a<space><lt>Rejected<gt><space>feature.<space><space>To<space>continue<space>translation<space>when<space>features<space>are<space>rejected<comma><space>change<space><apos>Workspace<space>Parameters<apos><space><gt><space>Log<space>and<space>Troubleshoot<space><gt><space><apos>Rejected<space>Feature<space>Handling<apos><space>to<space><apos>Continue<space>Translation<apos>)
# -------------------------------------------------------------------------
# Build the List removal function and regular expression if there was any list attributes to be removed.
# If not, then we will not have any extra list removal call to @RemoveAttributes, which speeds the
# normal, non-list removal especially when in Bulk Mode.  Note that this computation of the regular expressions is done
# once during mapping file parse time.
INCLUDE [    set listAttributeRemoveRegexps {};    set anyList {no};    foreach attr [split ""] {       set attr [FME_DecodeText $attr];       set attr [regsub "{}$" $attr "{}.*"];       set attr [regsub -all "{}" $attr "\\{\[0-9\]+\\}"];       append listAttributeRemoveRegexps ",^$attr$";       set anyList {yes};    };    if { ${anyList} == {no} } {        puts {MACRO $(SentinelDownloader_WORKSPACE_NAME)_AttributeRemover_5_LIST_FUNC }    } else {        puts "MACRO $(SentinelDownloader_WORKSPACE_NAME)_AttributeRemover_5_LIST_FUNC @RemoveAttributes(fme_pcre_match\"$listAttributeRemoveRegexps\")"    }; ]
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(SentinelDownloader_WORKSPACE_NAME)_AttributeRemover_5 }    INPUT  FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_FeatureReader_2_JPEG2000"    OUTPUT { FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_AttributeRemover_5_OUTPUT"        @RemoveAttributes(fme_encoded,Id,Nodes.uri,_http_status_code,_response_file_path,access_token)        $($(SentinelDownloader_WORKSPACE_NAME)_AttributeRemover_5_LIST_FUNC)         }
