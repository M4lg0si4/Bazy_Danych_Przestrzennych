E_PASSWORD { "<Unused>" }    OUTPUT { OUTPUT FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_HTTPCaller_3_Output"          }    OUTPUT { REJECTED FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_HTTPCaller_3_<REJECTED>"          }
