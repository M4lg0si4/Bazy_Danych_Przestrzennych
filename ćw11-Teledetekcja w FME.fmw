GUI OPTIONAL DISCLOSUREGROUP WFS_IN_FME_GROUP_NAMED1_WFS_1 WFS_IN_DATASET%WFS_IN_PREFER_DATASET_URL_WFS_1%WFS_IN_PREFERRED_VERSION_WFS_1%WFS_IN_IGNORE_GETFEATURE_ERROR_WFS_1%WFS_IN_GETFEATURE_PROCESSING_MODE_WFS_1%WFS_IN_NETWORK_AUTHENTICATION_WFS_1%WFS_IN_CONNECTION_PROPERTIES_GROUP_WFS_1 WFS Connection
