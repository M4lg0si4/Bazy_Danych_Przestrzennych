_B04.jp2 ENCODED } TEST { @EvaluateExpression(FDIV,STRING_ENCODED,$($(SentinelDownloader_WORKSPACE_NAME)_B8_10m$encode),$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_3) = YES ENCODED } CASE_INSENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>Id<closeparen>,$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_3) ENDS_WITH _B08.jp2 ENCODED } TEST { @EvaluateExpression(FDIV,STRING_ENCODED,$($(SentinelDownloader_WORKSPACE_NAME)_TCI_10m$encode),$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_3) = YES ENCODED } CASE_INSENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>Id<closeparen>,$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_3) ENDS_WITH _TCI.jp2 ENCODED } BOOLEAN_OPERATOR COMPOSITE COMPOSITE_TEST_EXPR "( 1 AND 2 ) OR ( 3 AND 4 ) OR  ( 5 AND 6 ) OR ( 7 AND 8 ) OR ( 9 AND 10 ) OR ( 11 AND 12 )" OUTPUT PASSED_1 FEATURE_TYPE $(SentinelDownloader_WORKSPACE_NAME)_TestFilter_3_Bands<space>2<space>download TEST_GROUP TEST { @EvaluateExpression(FDIV,STRING_ENCODED,$($(SentinelDownloader_WORKSPACE_NAME)_ALL_BANDS_20$encode),$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_3) = YES ENCODED } CASE_INSENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>Id<closeparen>,$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_3) CONTAINS_REGEX _<openparen>B8A|B0<openparen>5|6||8<closeparen>|B1<openparen>1|2<closeparen><closeparen>.jp2<dollar> ENCODED } TEST { @EvaluateExpression(FDIV,STRING_ENCODED,$($(SentinelDownloader_WORKSPACE_NAME)_B5_20m$encode),$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_3) = YES ENCODED } CASE_INSENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>Id<closeparen>,$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_3) ENDS_WITH _B05.jp2 ENCODED } TEST { @EvaluateExpression(FDIV,STRING_ENCODED,$($(SentinelDownloader_WORKSPACE_NAME)_B6_20m$encode),$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_3) = YES ENCODED } CASE_INSENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>Id<closeparen>,$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_3) ENDS_WITH _B06.jp2 ENCODED } TEST { @EvaluateExpression(FDIV,STRING_ENCODED,$($(SentinelDownloader_WORKSPACE_NAME)_B7_20m$encode),$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_3) = YES ENCODED } CASE_INSENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>Id<closeparen>,$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_3) ENDS_WITH _B07.jp2 ENCODED } TEST { @EvaluateExpression(FDIV,STRING_ENCODED,$($(SentinelDownloader_WORKSPACE_NAME)_B8_20m$encode),$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_3) = YES ENCODED } CASE_INSENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>Id<closeparen>,$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_3) ENDS_WITH _B8A.jp2 ENCODED } TEST { @EvaluateExpression(FDIV,STRING_ENCODED,$($(SentinelDownloader_WORKSPACE_NAME)_B11_20m$encode),$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_3) = YES ENCODED } CASE_INSENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>Id<closeparen>,$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_3) ENDS_WITH _B11.jp2 ENCODED } TEST { @EvaluateExpression(FDIV,STRING_ENCODED,$($(SentinelDownloader_WORKSPACE_NAME)_B12_20m$encode),$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_3) = YES ENCODED } CASE_INSENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>Id<closeparen>,$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_3) ENDS_WITH _B12.jp2 ENCODED } BOOLEAN_OPERATOR COMPOSITE COMPOSITE_TEST_EXPR "( 1 AND 2 ) OR ( 3 AND 4 ) OR  ( 5 AND 6 ) OR ( 7 AND 8 ) OR ( 9 AND 10 ) OR ( 11 AND 12 ) OR ( 13 AND 14 )" OUTPUT PASSED_2 FEATURE_TYPE $(SentinelDownloader_WORKSPACE_NAME)_TestFilter_3_Bands<space>2<space>download TEST_GROUP TEST { @EvaluateExpression(FDIV,STRING_ENCODED,$($(SentinelDownloader_WORKSPACE_NAME)_ALL_BANDS_60$encode),$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_3) = YES ENCODED } CASE_INSENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>Id<closeparen>,$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_3) CONTAINS_REGEX _<openparen>B10|B0<openparen>1|9<closeparen><closeparen>.jp2<dollar> ENCODED } TEST { @EvaluateExpression(FDIV,STRING_ENCODED,$($(SentinelDownloader_WORKSPACE_NAME)_B1_60m$encode),$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_3) = YES ENCODED } CASE_INSENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>Id<closeparen>,$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_3) ENDS_WITH _B01.jp2 ENCODED } TEST { @EvaluateExpression(FDIV,STRING_ENCODED,$($(SentinelDownloader_WORKSPACE_NAME)_B9_60m$encode),$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_3) = YES ENCODED } CASE_INSENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>Id<closeparen>,$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_3) ENDS_WITH _B09.jp2 ENCODED } BOOLEAN_OPERATOR COMPOSITE COMPOSITE_TEST_EXPR "( 1 AND 2 ) OR ( 3 AND 4 ) OR  ( 5 AND 6 )" OUTPUT PASSED_3 FEATURE_TYPE $(SentinelDownloader_WORKSPACE_NAME)_TestFilter_3_Bands<space>2<space>download OUTPUT FAILED FEATURE_TYPE $(SentinelDownloader_WORKSPACE_NAME)_TestFilter_3_<lt>UNFILTERED<gt>
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_3 <lt>UNFILTERED<gt> Transformer Output Nuker"   INPUT FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_3_<lt>UNFILTERED<gt>"
